###############################################################################
# VIPURI — Backend (Laravel) environment configuration
###############################################################################

APP_NAME=VIPURI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://127.0.0.1:8000

# Public URL of the Next.js storefront/dashboard. Used for CORS, e-mail links,
# password-reset links and payment gateway redirects.
FRONTEND_URL=http://127.0.0.1:3000

# Extra browser origins allowed to call the API (comma separated).
ADDITIONAL_CORS_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database (MySQL)
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vipuri
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Session / cache / queue
###############################################################################
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=vipuri

###############################################################################
# Sanctum (SPA / token auth)
###############################################################################
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:3000,localhost:3000

###############################################################################
# Currency — VIPURI operates in Tanzanian Shillings
###############################################################################
CURRENCY_TEXT=TZS
CURRENCY_SYMBOL=TSh

# API rate limits, requests per minute. Authentication endpoints keep their own
# tighter throttles regardless of these values.
RATE_LIMIT_ADMIN=600
RATE_LIMIT_USER=240
RATE_LIMIT_GUEST=120
# Gateway webhooks (/api/v1/ipn/*). Machine traffic, so it gets its own budget.
RATE_LIMIT_IPN=300

# Emit every generated URL as https. Turn this on behind a TLS-terminating
# proxy, where the app itself sees plain HTTP.
FORCE_HTTPS=false

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@vipuri.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# AI providers (product copy generation, review summaries, product chat)
# Keys may also be set from the admin panel (Settings -> System Configuration).
###############################################################################
# 1 = Gemini, 2 = OpenAI
AI_DEFAULT_ENGINE=2
OPENAI_API_KEY=
OPENAI_API_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-2.5-flash

###############################################################################
# Payment gateways — only fill in the ones you actually use.
# Credentials can also be managed from Admin -> Payment Gateways.
###############################################################################
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (REST)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Flutterwave — card + Tanzanian mobile money (M-Pesa, Tigo Pesa, Airtel Money, Halopesa)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

###############################################################################
# SMS (order + account notifications)
###############################################################################
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
NEXMO_API_KEY=
NEXMO_API_SECRET=

###############################################################################
# Firebase push notifications (optional)
###############################################################################
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

###############################################################################
# Development seeding
# Password used by DatabaseSeeder for every seeded account.
###############################################################################
SEED_PASSWORD=
